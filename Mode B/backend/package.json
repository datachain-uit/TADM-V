{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test -r ts-node/register src/tests/ipfsEncryption.test.ts src/tests/publicSurface.test.ts src/tests/proverClient.test.ts src/tests/authorizeStaff.test.ts src/tests/staffLogin.test.ts src/tests/poolAndWalletConstraints.test.ts src/tests/withdrawOrderChannel.test.ts src/tests/realArtifactAudit.test.ts src/tests/merklePath.test.ts src/tests/apiBoundary.test.ts src/tests/studentApiBoundary.test.ts src/tests/layerBoundary.test.ts src/tests/chainRead.test.ts",
    "db:test": "ts-node src/scripts/testDatabaseConnection.ts",
    "flow:reset": "ts-node src/scripts/resetDatabase.ts",
    "flow:full": "ts-node src/scripts/fullFlow.ts",
    "university:create": "ts-node src/cli/university.cli.ts",
    "staff:create": "ts-node src/cli/staff.cli.ts",
    "staff:password": "ts-node -e \"require('./src/cli/staff.cli').runSetStaffPasswordCli(process.argv.slice(1)).catch(require('./src/cli/errorHandler').handleCliError)\"",
    "staff:login": "ts-node -e \"require('./src/cli/staff.cli').runStaffLoginCli(process.argv.slice(1)).catch(require('./src/cli/errorHandler').handleCliError)\"",
    "student:create": "ts-node src/cli/student.cli.ts create",
    "student:eligibility": "ts-node src/cli/student.cli.ts eligibility",
    "student:finance": "ts-node src/cli/student.cli.ts finance",
    "student:pubkey": "ts-node src/cli/zkProof.cli.ts derive",
    "student:wallet": "ts-node src/cli/student.cli.ts wallet",
    "student:password": "ts-node src/cli/student.cli.ts password",
    "pool:create": "ts-node src/cli/pool.cli.ts create",
    "pool:deploy": "ts-node src/cli/pool.cli.ts deploy",
    "pool:fund": "ts-node src/cli/pool.cli.ts fund",
    "pool:fund-record": "ts-node src/cli/pool.cli.ts fund-record",
    "pool:balance": "ts-node src/cli/pool.cli.ts balance",
    "scholarship:issue": "ts-node src/cli/scholarship.cli.ts",
    "root:approve": "ts-node src/cli/rootApproval.cli.ts",
    "note:decrypt": "ts-node src/cli/note.cli.ts",
    "withdrawal:create": "ts-node src/cli/withdrawal.cli.ts create",
    "withdrawal:review": "ts-node src/cli/withdrawal.cli.ts review",
    "withdrawal:review-batch": "ts-node src/cli/withdrawal.cli.ts review-batch",
    "experiment:qualitative": "ts-node src/cli/qualitativeExperiment.cli.ts",
    "experiment:anonymity": "ts-node src/experiments/anonymityExperiment.ts",
    "experiment:prepare": "ts-node src/experiments/prepareExperimentInputs.ts",
    "experiment:proofs": "ts-node src/experiments/generateAllProofs.ts",
    "experiment:gas": "ts-node src/experiments/benchmarkGas.ts",
    "experiment:repeated": "ts-node src/experiments/repeatedRunsExperiment.ts",
    "experiment:repeated:summary": "ts-node src/experiments/summarizeRepeatedRuns.ts",
    "experiment:multipool": "ts-node src/experiments/multiPoolExperiment.ts",
    "experiment:multipool-parallel": "ts-node src/experiments/multiPoolParallelExperiment.ts",
    "experiment:artifacts": "ts-node src/experiments/recordArtifactSizes.ts",
    "experiment:sepolia": "ts-node src/experiments/sepoliaValidation.ts",
    "experiment:sepolia-fresh-proofs": "ts-node src/experiments/freshRecipientProofs.ts",
    "experiment:insider-proof": "ts-node src/experiments/insiderDiversionProof.ts",
    "start": "ts-node src/server.ts",
    "dev": "ts-node-dev --respawn src/server.ts",
    "api:start": "ts-node src/server.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "ipfs-http-client": "^56.0.3",
    "mongoose": "^9.8.0",
    "web3": "^4.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.4",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
